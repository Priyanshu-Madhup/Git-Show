# Which provider the agents use: "openrouter" (default) or "gemini".
LLM_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/qwen/qwen3.7-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Gemini — kept configured as a fallback; set LLM_PROVIDER=gemini to switch back.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Wity — https://wity.alphanimble.com/docs. Makes the orchestrator's routing decisions;
# without a key the main model decides instead.
WITY_API_KEY=your_wity_api_key_here
WITY_BASE_URL=https://wity-proxy-production-2c33.up.railway.app

GITHUB_APP_ID=your_github_app_id_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
FRONTEND_URL=http://localhost:5173

# Supabase — backend-only. Secret key: Project Settings -> API Keys.
# DB URL: Connect -> Direct -> Session pooler (URL-encode special chars in the password).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres
# Encrypts GitHub access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# --- Optional: only needed when hosting (local dev works without these) -----
# GitHub App URL name (github.com/apps/<slug>); shows the "Install Git Show" link.
# GITHUB_APP_SLUG=your-app-slug
# Serve the built frontend (frontend/dist) from this server: one origin, one process.
# SERVE_FRONTEND=1
# Only if the frontend is on a different origin than the API (comma-separated).
# CORS_ORIGINS=https://your-frontend.example.com
# Defaults to true when FRONTEND_URL is https.
# COOKIE_SECURE=true
